# Required cloud configuration. Only NEXT_PUBLIC_* values are published to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after the provider has been configured and tested in Supabase.
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
# Set false when no working public SMTP service is configured.
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional PostgreSQL connection for Drizzle maintenance; runtime uses Supabase REST.
DATABASE_URL=
# Optional: official YouTube music/film/gaming mostPopular sources. Server-side only.
YOUTUBE_API_KEY=
# Optional UAPI token: authenticated quota for remaining domestic feeds.
UAPI_KEY=
